    // MARK DELIVERY
    async function markDelivered(subId, defaultQty) {
      const qty = prompt('Delivered quantity (kg):', defaultQty);
      if (qty === null) return;
      try {
        const res = await fetch('/api/subscriptions/' + subId + '/deliver', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ quantity: parseFloat(qty) || defaultQty })
        });
        const data = await res.json();
        if (data.success) {
          showToast('Delivery recorded! Next delivery: ' + data.next_delivery);
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.error || 'Error recording delivery', 'error');
        }
      } catch (err) {
        showToast('Network error', 'error');
      }
    }

    // TOGGLE DELIVERY HISTORY
    async function toggleDeliveries(subId, btn) {
      const row = document.getElementById('hist-' + subId);
      if (row.style.display === 'none') {
        row.style.display = '';
        btn.textContent = 'Hide';
        const content = document.getElementById('hist-content-' + subId);
        try {
          const res = await fetch('/api/subscriptions/' + subId + '/deliveries');
          const deliveries = await res.json();
          if (deliveries.length === 0) {
            content.innerHTML = '<em>No deliveries recorded yet.</em>';
          } else {
            content.innerHTML = '<table style="width:100%;margin-top:4px"><thead><tr style="background:#e8ecf1"><th style="padding:6px;font-size:0.75rem">Date</th><th style="padding:6px;font-size:0.75rem">Qty</th><th style="padding:6px;font-size:0.75rem">Notes</th></tr></thead><tbody>' +
              deliveries.map(d => '<tr><td style="padding:6px">' + new Date(d.delivered_date).toLocaleDateString('en-IN') + '</td><td style="padding:6px">' + d.quantity + ' kg</td><td style="padding:6px">' + (d.notes || '—') + '</td></tr>').join('') +
              '</tbody></table>';
          }
        } catch (err) {
          content.innerHTML = '<em style="color:#dc3545">Error loading history</em>';
        }
      } else {
        row.style.display = 'none';
        btn.textContent = 'History';
      }
    }

    // ESC key closes modal
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') { closeProductModal(); closePasteOrderModal(); closeDistModal(); }
    });

    // PASTE ORDER MODAL
    function openPasteOrderModal() {
      document.getElementById('pasteOrderModal').classList.add('show');
      document.getElementById('pasteInput').value = '';
      document.getElementById('parsedResult').style.display = 'none';
      document.getElementById('pasteInput').focus();
    }

    function closePasteOrderModal() {
      document.getElementById('pasteOrderModal').classList.remove('show');
    }

    async function parsePastedOrder() {
      const raw = document.getElementById('pasteInput').value.trim();
      if (!raw) return showToast('Paste the WhatsApp order message first', 'error');

      const btn = document.getElementById('parseBtn');
      btn.disabled = true;
      btn.textContent = 'Parsing...';

      try {
        const res = await fetch('/api/agents/order/parse', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: raw })
        });
        const data = await res.json();

        if (data.error) {
          showToast(data.error, 'error');
          return;
        }

        // Show parsed result
        document.getElementById('parsedResult').style.display = 'block';
        document.getElementById('po_name').value = data.customer_name || '';
        document.getElementById('po_phone').value = data.phone || '';
        document.getElementById('po_notes').value = data.notes || '';

        // Show items
        const itemsDiv = document.getElementById('po_items');
        if (data.products && data.products.length > 0) {
          itemsDiv.innerHTML = '<table style="width:100%;border-collapse:collapse"><thead><tr style="background:#f0f2f5"><th style="padding:8px;text-align:left">Product</th><th style="padding:8px;text-align:center">Qty</th><th style="padding:8px;text-align:right">Price</th></tr></thead><tbody>' +
            data.products.map(p => {
              const prod = productsMap[p.productId] || {};
              return '<tr><td style="padding:8px">' + (prod.name_en || p.productId) + '</td><td style="padding:8px;text-align:center">' + (p.quantity || 1) + ' kg</td><td style="padding:8px;text-align:right">₹' + (prod.price || 0) + '</td></tr>';
            }).join('') + '</tbody></table>';

          const total = data.products.reduce((sum, p) => {
            const prod = productsMap[p.productId] || {};
            return sum + (prod.price || 0) * (p.quantity || 1);
          }, 0);
          document.getElementById('po_total').textContent = '₹' + total.toLocaleString('en-IN');
        } else {
          itemsDiv.innerHTML = '<em style="color:#888">No products detected. Add manually below.</em>';
          document.getElementById('po_total').textContent = '₹0';
        }

        // Store parsed data for submission
        document.getElementById('pasteOrderModal').dataset.parsed = JSON.stringify(data);

        if (data.order_created) {
          showToast('Order auto-created by AI! Check orders list.', 'success');
          setTimeout(() => location.reload(), 1500);
        }

      } catch (err) {
        showToast('Network error', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Parse Message';
      }
    }

    function togglePasteChannel() {
      const sel = document.getElementById('po_channel');
      const isDist = sel.value !== 'direct';
      document.getElementById('po_name_wrap').querySelector('label').textContent = isDist ? 'Customer Name (optional)' : 'Customer Name *';
    }

    async function submitParsedOrder() {
      const parsed = JSON.parse(document.getElementById('pasteOrderModal').dataset.parsed || '{}');
      const name = document.getElementById('po_name').value.trim();
      const phone = document.getElementById('po_phone').value.trim();
      const notes = document.getElementById('po_notes').value.trim();
      const channelSel = document.getElementById('po_channel');
      const isDistOrder = channelSel.value !== 'direct';

      if (!isDistOrder && !name) return showToast('Customer name is required for direct orders', 'error');
      if (!parsed.products || parsed.products.length === 0) return showToast('No products detected', 'error');

      // Build items with prices
      const items = parsed.products.map(p => {
        const prod = productsMap[p.productId] || {};
        return { productId: p.productId, quantity: p.quantity || 1, price: prod.price || 0 };
      });
      const total = Math.ceil(items.reduce((sum, i) => sum + i.price * i.quantity, 0));

      const body = {
        customerName: name,
        phone: phone,
        address: '',
        items: items,
        notes: notes
      };

      if (isDistOrder) {
        body.distributorId = channelSel.value;
        body.channel = 'distributor';
      }

      try {
        const res = await fetch('/api/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.ok || data.order) {
          showToast('Order created! Total: ₹' + total.toLocaleString('en-IN'), 'success');
          closePasteOrderModal();
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.error || 'Error creating order', 'error');
        }
      } catch (err) {
        showToast('Network error', 'error');
      }
    }
  </script>

  <!-- PASTE ORDER MODAL -->
  <div id="pasteOrderModal" class="modal-overlay">
    <div class="modal-box" style="max-width:600px">
      <div class="modal-header">
        <h3>Paste WhatsApp Order</h3>
        <button class="modal-x" onclick="closePasteOrderModal()">&times;</button>
      </div>
      <div style="padding:24px">
        <p style="font-size:0.85rem;color:#666;margin-bottom:12px">Paste the WhatsApp order message or catalogue order card below. AI will extract customer details and products.</p>
        <textarea id="pasteInput" rows="6" style="width:100%;padding:12px;border:2px solid #e0e0e0;border-radius:10px;font-family:Poppins,sans-serif;font-size:0.9rem;resize:vertical" placeholder="Paste WhatsApp message here...&#10;&#10;Example:&#10;1x Nachani Dosa Atta (1 kg) — ₹225&#10;1x Barley Dosa Atta (1 kg) — ₹275&#10;Total: ₹500"></textarea>
        <button id="parseBtn" class="btn btn-primary" style="margin-top:12px;width:100%" onclick="parsePastedOrder()">Parse Message</button>

        <div id="parsedResult" style="display:none;margin-top:20px">
          <h4 style="margin-bottom:12px;color:#2d5a27">Parsed Order</h4>
          <div style="display:grid;gap:12px;margin-bottom:16px">
            <div>
              <label style="font-weight:600;font-size:0.8rem;color:#555">Channel</label>
              <select id="po_channel" onchange="togglePasteChannel()" style="width:100%;padding:10px;border:2px solid #e0e0e0;border-radius:8px;font-family:Poppins,sans-serif">
                <option value="direct">Direct Retail</option>
                <% distributors.filter(d => d.active !== false).forEach(d => { %>
                  <option value="<%= d.id %>" data-commission="<%= d.commission_pct %>" data-name="<%= d.name %>"><%= d.name %> — <%= d.commission_pct %>% comm.</option>
                <% }) %>
              </select>
            </div>
            <div id="po_name_wrap">
              <label style="font-weight:600;font-size:0.8rem;color:#555">Customer Name *</label>
              <input type="text" id="po_name" style="width:100%;padding:10px;border:2px solid #e0e0e0;border-radius:8px;font-family:Poppins,sans-serif" placeholder="Customer name">
            </div>
            <div>
              <label style="font-weight:600;font-size:0.8rem;color:#555">Phone</label>
              <input type="tel" id="po_phone" style="width:100%;padding:10px;border:2px solid #e0e0e0;border-radius:8px;font-family:Poppins,sans-serif" placeholder="9876543210">
            </div>
          </div>

          <div id="po_items" style="margin-bottom:16px"></div>

          <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:#e8f5e1;border-radius:10px;margin-bottom:12px">
            <span style="font-weight:600">Total</span>
            <span id="po_total" style="font-size:1.2rem;font-weight:700;color:#2d5a27">₹0</span>
          </div>

          <div style="margin-bottom:16px">
            <label style="font-weight:600;font-size:0.8rem;color:#555">Notes</label>
            <input type="text" id="po_notes" style="width:100%;padding:10px;border:2px solid #e0e0e0;border-radius:8px;font-family:Poppins,sans-serif" placeholder="Special instructions">
          </div>

          <button class="btn btn-primary" style="width:100%" onclick="submitParsedOrder()">Create Order</button>
        </div>
      </div>
    </div>
  </div>
  <!-- DISTRIBUTOR MODAL -->
  <div id="distModal" class="modal-overlay" onclick="if(event.target===this)closeDistModal()">
    <div class="modal" style="max-width:550px">
      <div class="modal-header">
        <h3 id="distModalTitle">Add Distributor</h3>
        <button class="modal-close" onclick="closeDistModal()">&times;</button>
      </div>
      <form id="distForm" onsubmit="saveDist(event)">
        <div class="modal-body">
          <input type="hidden" id="df_id" value="">
          <div class="form-grid">
            <div class="form-group">
              <label>Name *</label>
              <input type="text" id="df_name" required placeholder="e.g. Raj Stores">
            </div>
            <div class="form-group">
              <label>Phone</label>
              <input type="tel" id="df_phone" placeholder="9876543210">
            </div>
            <div class="form-group">
              <label>Company</label>
              <input type="text" id="df_company" placeholder="Business name">
            </div>
            <div class="form-group">
              <label>City</label>
              <input type="text" id="df_city" placeholder="e.g. Pune">
            </div>
            <div class="form-group">
              <label>Address</label>
              <input type="text" id="df_address" placeholder="Full address">
            </div>
            <div class="form-group">
              <label>Commission % *</label>
              <input type="number" id="df_commission" min="0" max="100" step="0.5" value="15" required>
              <small style="color:#888;font-size:0.75rem">% of order total they keep as their margin</small>
            </div>
          </div>
          <div class="form-group">
            <label>Notes</label>
            <textarea id="df_notes" rows="2" placeholder="Payment terms, preferred products, etc."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" onclick="closeDistModal()">Cancel</button>
          <button type="submit" class="btn btn-primary" id="df_submit">Add Distributor</button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>

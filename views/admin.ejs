    // QUICK ORDER ENTRY
    const quickItems = [];

    function addQuickItem() {
      const sel = document.getElementById('qo_product');
      const opt = sel.options[sel.selectedIndex];
      if (!opt.value) return showToast('Select a product', 'error');

      const qty = parseFloat(document.getElementById('qo_qty').value) || 1;
      const existing = quickItems.find(i => i.productId === opt.value);
      if (existing) {
        existing.quantity += qty;
      } else {
        quickItems.push({
          productId: opt.value,
          name: opt.dataset.name,
          price: parseInt(opt.dataset.price),
          quantity: qty
        });
      }
      sel.selectedIndex = 0;
      document.getElementById('qo_qty').value = 1;
      renderQuickItems();
    }

    function removeQuickItem(idx) {
      quickItems.splice(idx, 1);
      renderQuickItems();
    }

    function renderQuickItems() {
      const div = document.getElementById('qo_items');
      const totalDiv = document.getElementById('qo_total');
      const submitBtn = document.getElementById('qo_submit');
      const commDiv = document.getElementById('qo_commission');

      if (quickItems.length === 0) {
        div.innerHTML = '';
        totalDiv.style.display = 'none';
        commDiv.style.display = 'none';
        submitBtn.style.display = 'none';
        return;
      }

      div.innerHTML = quickItems.map((item, i) =>
        '<div class="qo-item"><span>' + item.name + ' × ' + item.quantity + ' kg</span><span>₹' + Math.ceil(item.price * item.quantity).toLocaleString('en-IN') + ' <span class="remove" onclick="removeQuickItem(' + i + ')">×</span></span></div>'
      ).join('');

      const total = Math.ceil(quickItems.reduce((s, i) => s + i.price * i.quantity, 0));
      totalDiv.querySelector('span:last-child').textContent = '₹' + total.toLocaleString('en-IN');
      totalDiv.style.display = 'flex';
      submitBtn.style.display = 'block';

      // Commission breakdown
      const channelSel = document.getElementById('qo_channel');
      const opt = channelSel.options[channelSel.selectedIndex];
      if (channelSel.value !== 'direct') {
        const pct = parseFloat(opt.dataset.commission || 0);
        const commAmt = Math.round(total * pct / 100);
        const net = total - commAmt;
        document.getElementById('qo_comm_pct').textContent = pct;
        document.getElementById('qo_comm_amt').textContent = '₹' + commAmt.toLocaleString('en-IN');
        document.getElementById('qo_net').textContent = '₹' + net.toLocaleString('en-IN');
        commDiv.style.display = 'block';
      } else {
        commDiv.style.display = 'none';
      }
    }

    async function submitQuickOrder() {
      const channelSel = document.getElementById('qo_channel');
      const isDistOrder = channelSel.value !== 'direct';
      const name = document.getElementById('qo_name').value.trim();
      const phone = document.getElementById('qo_phone').value.trim();
      const address = document.getElementById('qo_address').value.trim();
      const area = document.getElementById('qo_area') ? document.getElementById('qo_area').value.trim() : '';
      const city = document.getElementById('qo_city') ? document.getElementById('qo_city').value.trim() : '';

      if (!isDistOrder && !name) return showToast('Customer name is required for direct orders', 'error');
      if (quickItems.length === 0) return showToast('Add at least one product', 'error');

      const btn = document.getElementById('qo_submit');
      btn.disabled = true;
      btn.textContent = 'Creating...';

      const body = {
        customerName: name,
        phone: phone || '',
        address: address,
        items: quickItems.map(i => ({ productId: i.productId, quantity: i.quantity })),
      };

      if (isDistOrder) {
        body.distributorId = channelSel.value;
        body.channel = 'distributor';
        body.deliveryArea = area;
        body.city = city;
      }

      try {
        const res = await fetch('/api/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.ok || data.order) {
          const total = Math.ceil(quickItems.reduce((s, i) => s + i.price * i.quantity, 0));
          const distName = isDistOrder ? channelSel.options[channelSel.selectedIndex].dataset.name : '';
          showToast('Order created' + (isDistOrder ? ' for ' + distName : '') + '! Total: ₹' + total.toLocaleString('en-IN'), 'success');
          quickItems.length = 0;
          renderQuickItems();
          document.getElementById('qo_name').value = '';
          document.getElementById('qo_phone').value = '';
          document.getElementById('qo_address').value = '';
          if (document.getElementById('qo_area')) document.getElementById('qo_area').value = '';
          if (document.getElementById('qo_city')) document.getElementById('qo_city').value = '';
          document.getElementById('qo_channel').selectedIndex = 0;
          toggleChannelFields();
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.error || 'Error creating order', 'error');
        }
      } catch (err) {
        showToast('Network error', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Create Order';
      }
    }

    // ORDER STATUS
    async function updateOrderStatus(id, status) {
      await fetch('/api/orders/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      showToast('Order status updated');

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard — Annapurna Arogya Peeth</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Poppins', sans-serif; background: #f0f2f5; color: #333; }

    /* TOPBAR */
    .topbar { background: linear-gradient(135deg, #2d5a27, #4a7c3f); color: #fff; padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 12px rgba(0,0,0,0.15); }
    .topbar h1 { font-size: 1.2rem; display: flex; align-items: center; gap: 10px; }
    .topbar .actions { display: flex; gap: 16px; align-items: center; }
    .topbar a { color: #aed9ff; text-decoration: none; font-size: 0.9rem; }
    .topbar a:hover { text-decoration: underline; }

    /* CONTAINER */
    .container { max-width: 1200px; margin: 0 auto; padding: 24px; }

    /* STATS */
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 32px; }
    .stat-card { background: #fff; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-align: center; transition: transform 0.2s; cursor: pointer; }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
    .stat-card .number { font-size: 2rem; font-weight: 700; color: #2d5a27; }
    .stat-card .label { color: #888; font-size: 0.85rem; margin-top: 4px; }

    /* FILTER BAR */
    .filter-bar { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
    .filter-btn { padding: 6px 16px; border: 2px solid #e0e0e0; border-radius: 20px; background: #fff; color: #555; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s; font-family: 'Poppins', sans-serif; }
    .filter-btn:hover { border-color: #2d5a27; color: #2d5a27; }
    .filter-btn.active { background: #2d5a27; border-color: #2d5a27; color: #fff; }

    /* QUICK ORDER FORM */
    .quick-order { background: #f8f9fa; border-radius: 12px; padding: 20px; margin-bottom: 24px; border: 2px dashed #d0d5dd; }
    .quick-order h3 { font-size: 1rem; color: #2d5a27; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
    .qo-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .qo-field label { display: block; font-size: 0.75rem; font-weight: 600; color: #555; margin-bottom: 4px; }
    .qo-field input, .qo-field select { width: 100%; padding: 8px 12px; border: 2px solid #e0e0e0; border-radius: 8px; font-family: 'Poppins', sans-serif; font-size: 0.85rem; }
    .qo-field input:focus, .qo-field select:focus { outline: none; border-color: #4a7c3f; }
    .qo-add-row { display: flex; gap: 8px; align-items: end; margin-bottom: 12px; }
    .qo-add-row select { flex: 1; padding: 8px 12px; border: 2px solid #e0e0e0; border-radius: 8px; font-family: 'Poppins', sans-serif; font-size: 0.85rem; }
    .qo-add-row input { width: 80px; padding: 8px 12px; border: 2px solid #e0e0e0; border-radius: 8px; font-family: 'Poppins', sans-serif; font-size: 0.85rem; text-align: center; }
    .qo-items { margin-bottom: 12px; }
    .qo-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: #fff; border-radius: 8px; margin-bottom: 4px; border: 1px solid #e8ecf1; }
    .qo-item .remove { cursor: pointer; color: #dc3545; font-weight: 700; padding: 0 4px; }
    .qo-total { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: #e8f5e1; border-radius: 10px; margin-top: 12px; }
    .qo-total span:last-child { font-size: 1.2rem; font-weight: 700; color: #2d5a27; }

    /* TABS */
    .tabs { display: flex; gap: 4px; margin-bottom: 0; }
    .tab { padding: 12px 28px; background: #fff; border: none; border-radius: 12px 12px 0 0; cursor: pointer; font-size: 0.9rem; font-weight: 600; color: #666; transition: all 0.2s; font-family: 'Poppins', sans-serif; }
    .tab.active { background: #2d5a27; color: #fff; }
    .tab:hover:not(.active) { background: #e8ecf1; }

    /* PANEL */
    .panel { display: none; background: #fff; border-radius: 0 12px 12px 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); overflow-x: auto; }
    .panel.active { display: block; }
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .panel-header h2 { font-size: 1.1rem; color: #2d5a27; }

    /* TABLE */
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 12px 16px; text-align: left; border-bottom: 1px solid #eee; font-size: 0.85rem; }
    th { background: #f8f9fa; font-weight: 600; color: #555; position: sticky; top: 0; }
    tr:hover { background: #f8f9fa; }

    /* BADGES */
    .badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-pending { background: #fff3cd; color: #856404; }
    .badge-confirmed { background: #d1ecf1; color: #0c5460; }
    .badge-delivered { background: #d4edda; color: #155724; }
    .badge-cancelled { background: #f8d7da; color: #721c24; }
    .badge-active { background: #d4edda; color: #155724; }
    .badge-paused { background: #fff3cd; color: #856404; }

    /* BUTTONS */
    .btn { padding: 8px 18px; border: none; border-radius: 8px; cursor: pointer; font-size: 0.8rem; font-weight: 600; font-family: 'Poppins', sans-serif; transition: all 0.2s; }
    .btn-sm { padding: 5px 12px; font-size: 0.75rem; }
    .btn-primary { background: #2d5a27; color: #fff; }
    .btn-primary:hover { background: #1e3d1a; }
    .btn-danger { background: #dc3545; color: #fff; }
    .btn-danger:hover { background: #b02a37; }
    .btn-success { background: #28a745; color: #fff; }
    .btn-success:hover { background: #1e7e34; }
    .btn-warning { background: #ffc107; color: #333; }
    .btn-warning:hover { background: #e0a800; }
    .btn-outline { background: transparent; border: 2px solid #2d5a27; color: #2d5a27; }
    .btn-outline:hover { background: #2d5a27; color: #fff; }
    .actions { display: flex; gap: 4px; flex-wrap: wrap; }

    /* FORM */
    select { padding: 6px 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 0.85rem; font-family: 'Poppins', sans-serif; }
    .product-name { font-weight: 600; }
    .product-price { color: #2d5a27; font-weight: 700; }
    .empty { text-align: center; padding: 48px; color: #aaa; }

    /* MODAL */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: flex-start; padding-top: 40px; overflow-y: auto; }
    .modal-overlay.show { display: flex; }
    .modal { background: #fff; border-radius: 16px; width: 100%; max-width: 700px; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
    .modal-header { padding: 20px 24px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; background: #fff; z-index: 1; border-radius: 16px 16px 0 0; }
    .modal-header h3 { font-size: 1.1rem; color: #2d5a27; }
    .modal-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #999; padding: 4px 8px; border-radius: 8px; }
    .modal-close:hover { background: #f0f0f0; color: #333; }
    .modal-body { padding: 24px; }
    .modal-footer { padding: 16px 24px; border-top: 1px solid #eee; display: flex; justify-content: flex-end; gap: 12px; position: sticky; bottom: 0; background: #fff; border-radius: 0 0 16px 16px; }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-group { margin-bottom: 16px; }
    .form-group.full { grid-column: 1 / -1; }
    .form-group label { display: block; font-weight: 600; color: #333; margin-bottom: 6px; font-size: 0.8rem; }
    .form-group input, .form-group textarea, .form-group select { width: 100%; padding: 10px 14px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 0.9rem; font-family: 'Poppins', sans-serif; transition: border-color 0.2s; }
    .form-group input:focus, .form-group textarea:focus, .form-group select:focus { outline: none; border-color: #2d5a27; }
    .form-group textarea { resize: vertical; min-height: 80px; }
    .form-section { font-weight: 700; color: #2d5a27; margin: 20px 0 12px; padding-bottom: 8px; border-bottom: 2px solid #e8f5e1; font-size: 0.9rem; }

    /* TOAST */
    .toast { position: fixed; top: 20px; right: 20px; padding: 14px 24px; border-radius: 10px; color: #fff; font-weight: 600; font-size: 0.9rem; z-index: 2000; transform: translateX(120%); transition: transform 0.3s ease; box-shadow: 0 4px 20px rgba(0,0,0,0.2); }
    .toast.show { transform: translateX(0); }
    .toast-success { background: #28a745; }
    .toast-error { background: #dc3545; }

    /* ORDER DETAIL */
    .order-items { font-size: 0.8rem; color: #555; }
    .order-items li { margin-left: 16px; }

    @media (max-width: 768px) {
      .form-grid { grid-template-columns: 1fr; }
      .topbar { flex-direction: column; gap: 8px; text-align: center; }
      .stats { grid-template-columns: repeat(2, 1fr); }
      .modal { margin: 10px; }
    }
  </style>
</head>
<body>
  <!-- TOAST -->
  <div id="toast" class="toast"></div>
  <% const productsMap = {}; products.forEach(p => { productsMap[p.id] = p; }); %>

  <!-- TOPBAR -->
  <div class="topbar">
    <h1>Annapurna Arogya Peeth — Admin</h1>
    <div class="actions">
      <a href="/admin/agent" style="background:rgba(255,255,255,0.2);padding:6px 14px;border-radius:8px;font-weight:600">AI Agent</a>
      <a href="/business-plan" target="_blank">Business Plan</a>
      <a href="/market-research" target="_blank">Market Research</a>
      <a href="/" target="_blank">View Website</a>
      <a href="/admin/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <!-- STATS -->
    <div class="stats">
      <div class="stat-card" onclick="document.querySelectorAll('.tab')[0].click()">
        <div class="number"><%= products.length %></div>
        <div class="label">Total Products</div>
      </div>
      <div class="stat-card" onclick="document.querySelectorAll('.tab')[0].click()">
        <div class="number"><%= products.filter(p => p.active !== false).length %></div>
        <div class="label">Active Products</div>
      </div>
      <div class="stat-card" onclick="document.querySelectorAll('.tab')[1].click()">
        <div class="number" id="stat-total-orders"><%= orders.filter(o => o.status !== 'cancelled').length %></div>
        <div class="label">Total Orders</div>
      </div>
      <div class="stat-card" onclick="document.querySelectorAll('.tab')[1].click()">
        <div class="number" id="stat-pending-orders"><%= orders.filter(o => o.status === 'pending').length %></div>
        <div class="label">Pending Orders</div>
      </div>
      <div class="stat-card" onclick="document.querySelectorAll('.tab')[2].click()">
        <div class="number"><%= subscriptions.filter(s => s.status === 'active').length %></div>
        <div class="label">Active Subscriptions</div>
      </div>
      <div class="stat-card" onclick="document.querySelectorAll('.tab')[1].click()">
        <div class="number" id="stat-revenue">₹<%= (orders.filter(o => o.status !== 'cancelled').reduce((sum, o) => sum + (o.total || 0), 0) + deliveries.reduce((sum, d) => sum + ((d.aap_subscriptions && d.aap_subscriptions.price) || 0), 0)).toLocaleString('en-IN') %></div>
        <div class="label">Total Revenue (Orders + Subs)</div>
      </div>
      <div class="stat-card" onclick="document.querySelectorAll('.tab')[2].click()">
        <div class="number" id="stat-sub-deliveries"><%= deliveries.length %></div>
        <div class="label">Sub Deliveries Made</div>
      </div>
      <div class="stat-card" onclick="document.querySelectorAll('.tab')[1].click();setTimeout(()=>applyChannelFilter('distributor',document.querySelector('[onclick*=distributor]')),100)">
        <div class="number" id="stat-dist-orders"><%= orders.filter(o => o.channel === 'distributor').length %></div>
        <div class="label">Distributor Orders</div>
      </div>
      <div class="stat-card" onclick="document.querySelectorAll('.tab')[4].click()">
        <div class="number" id="stat-commission-owed">₹<%= orders.filter(o => o.channel === 'distributor' && o.status !== 'cancelled').reduce((sum, o) => sum + (o.commission_amount || 0), 0).toLocaleString('en-IN') %></div>
        <div class="label">Commission Owed</div>
      </div>
    </div>

    <!-- TABS -->
    <div class="tabs">
      <button class="tab active" onclick="showTab('products', this)">Products</button>
      <button class="tab" onclick="showTab('orders', this)">Orders</button>
      <button class="tab" onclick="showTab('subscriptions', this)">Subscriptions</button>
      <button class="tab" onclick="showTab('customers', this)">Customers</button>
      <button class="tab" onclick="showTab('distributors', this)">Distributors</button>
    </div>

    <!-- PRODUCTS PANEL -->
    <div id="products" class="panel active">
      <div class="panel-header">
        <h2>Product Catalog</h2>
        <button class="btn btn-primary" onclick="openProductModal()">+ Add Product</button>
      </div>
      <% if (products.length === 0) { %>
        <div class="empty">No products yet. Click "Add Product" to create one.</div>
      <% } else { %>
        <table>
          <thead>
            <tr><th>Product</th><th>Category</th><th>Price/kg</th><th>Weight</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% products.forEach(p => { %>
              <tr>
                <td>
                  <span class="product-name"><%= p.emoji || '🌾' %> <%= p.name_en %></span><br>
                  <small style="color:#888"><%= p.name_mr %></small>
                </td>
                <td><span style="text-transform:capitalize"><%= p.category || 'millet' %></span></td>
                <td class="product-price">₹<%= p.price %></td>
                <td><%= p.weight_kg || 1 %> kg</td>
                <td><span class="badge badge-<%= p.active !== false ? 'active' : 'cancelled' %>"><%= p.active !== false ? 'Active' : 'Inactive' %></span></td>
                <td class="actions">
                  <button class="btn btn-sm btn-warning" onclick='editProduct(<%- JSON.stringify(p) %>)'>Edit</button>
                  <button class="btn btn-sm btn-<%= p.active !== false ? 'outline' : 'success' %>" onclick="toggleProduct('<%= p.id %>', <%= p.active === false %>)"><%= p.active === false ? 'Enable' : 'Disable' %></button>
                  <button class="btn btn-sm btn-danger" onclick="deleteProduct('<%= p.id %>', '<%= p.name_en %>')">Delete</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- ORDERS PANEL -->
    <div id="orders" class="panel">
      <div class="panel-header">
        <h2>Customer Orders</h2>
          <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
          <div class="filter-bar">
            <button class="filter-btn" onclick="applyFilter('wtd', this)">WTD</button>
            <button class="filter-btn" onclick="applyFilter('mtd', this)">MTD</button>
            <button class="filter-btn" onclick="applyFilter('ytd', this)">YTD</button>
            <button class="filter-btn active" onclick="applyFilter('ltd', this)">LTD</button>
            <span style="color:#ccc;margin:0 4px">|</span>
            <button class="filter-btn active" onclick="applyStatusFilter('all', this)">All</button>
            <button class="filter-btn" onclick="applyStatusFilter('pending', this)">Pending</button>
            <button class="filter-btn" onclick="applyStatusFilter('confirmed', this)">Confirmed</button>
            <button class="filter-btn" onclick="applyStatusFilter('delivered', this)">Delivered</button>
            <button class="filter-btn" onclick="applyStatusFilter('cancelled', this)">Cancelled</button>
            <span style="color:#ccc;margin:0 4px">|</span>
            <button class="filter-btn active" onclick="applyChannelFilter('all', this)">All Channels</button>
            <button class="filter-btn" onclick="applyChannelFilter('direct', this)">Direct</button>
            <button class="filter-btn" onclick="applyChannelFilter('distributor', this)">Distributor</button>
            <button class="filter-btn" onclick="applyChannelFilter('website', this)">Website</button>
          </div>
          <button class="btn btn-success" onclick="exportCSV()">⬇ Export CSV</button>
          <button class="btn btn-primary" onclick="openPasteOrderModal()">Paste Order</button>
        </div>
      </div>

      <!-- QUICK ORDER ENTRY -->
      <div class="quick-order">
        <h3>Quick Order Entry</h3>
        <div class="qo-row">
          <div class="qo-field">
            <label>Channel</label>
            <select id="qo_channel" onchange="toggleChannelFields()">
              <option value="direct">Direct Retail</option>
              <% distributors.filter(d => d.active !== false).forEach(d => { %>
                <option value="<%= d.id %>" data-commission="<%= d.commission_pct %>" data-name="<%= d.name %>"><%= d.name %> — <%= d.commission_pct %>% comm.</option>
              <% }) %>
            </select>
          </div>
          <div class="qo-field" id="qo_name_field">
            <label>Customer Name *</label>
            <input type="text" id="qo_name" placeholder="Full name">
          </div>
          <div class="qo-field" id="qo_phone_field">
            <label>Phone</label>
            <input type="tel" id="qo_phone" placeholder="9876543210" pattern="[0-9]{10}">
          </div>
        </div>
        <div class="qo-row" id="qo_address_row">
          <div class="qo-field">
            <label>Address</label>
            <input type="text" id="qo_address" placeholder="Delivery address">
          </div>
          <div class="qo-field" id="qo_area_field" style="display:none">
            <label>Delivery Area</label>
            <input type="text" id="qo_area" placeholder="e.g. Kothrud, Pune">
          </div>
          <div class="qo-field" id="qo_city_field" style="display:none">
            <label>City / Pincode</label>
            <input type="text" id="qo_city" placeholder="e.g. 411038">
          </div>
          <div></div>
        </div>
        <div class="qo-add-row">
          <div style="flex:1">
            <label style="display:block;font-size:0.75rem;font-weight:600;color:#555;margin-bottom:4px">Add Product</label>
            <select id="qo_product">
              <option value="">Select product...</option>
              <% products.filter(p => p.active !== false).forEach(p => { %>
                <option value="<%= p.id %>" data-price="<%= p.price %>" data-name="<%= p.name_en %>"><%= p.emoji || '🌾' %> <%= p.name_en %> — ₹<%= p.price %>/kg</option>
              <% }) %>
            </select>
          </div>
          <div>
            <label style="display:block;font-size:0.75rem;font-weight:600;color:#555;margin-bottom:4px">Qty (kg)</label>
            <input type="number" id="qo_qty" value="1" min="0.25" max="50" step="0.25">
          </div>
          <button class="btn btn-primary" onclick="addQuickItem()" style="padding:8px 16px">+ Add</button>
        </div>
        <div id="qo_items" class="qo-items"></div>
        <div id="qo_total" class="qo-total" style="display:none">
          <span style="font-weight:600">Total</span>
          <span>₹0</span>
        </div>
        <div id="qo_commission" style="display:none;padding:8px 16px;background:#fff3cd;border-radius:10px;margin-top:8px;font-size:0.85rem">
          <span style="font-weight:600">Distributor Commission (<label id="qo_comm_pct">0</label>%):</span>
          <span id="qo_comm_amt" style="font-weight:700;color:#856404">₹0</span>
          <span style="color:#888;margin-left:8px">← You receive <strong id="qo_net">₹0</strong></span>
        </div>
        <button id="qo_submit" class="btn btn-primary" style="width:100%;margin-top:12px;display:none" onclick="submitQuickOrder()">Create Order</button>
      </div>

      <div id="orders-empty" class="empty" style="display:<%= orders.length === 0 ? 'block' : 'none' %>">No orders found for the selected period.</div>
      <% if (orders.length > 0) { %>
        <table>
            <thead>
              <tr><th>ID</th><th>Channel</th><th>Customer</th><th>Phone</th><th>Items</th><th>Total</th><th>Commission</th><th>Date</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody id="orders-tbody">
            <% orders.slice().reverse().forEach(o => { %>
              <tr>
                <td><strong><%= o.id.slice(0,8) %></strong></td>
                <td>
                  <% if (o.channel === 'distributor' && o.distributor_id) { %>
                    <span class="badge badge-confirmed" style="font-size:0.65rem"><%= (distributors.find(d => d.id === o.distributor_id) || {}).name || o.distributor_id %></span>
                    <% if (o.delivery_area) { %><br><small style="color:#888"><%= o.delivery_area %></small><% } %>
                  <% } else if (o.channel === 'website') { %>
                    <span class="badge badge-pending" style="font-size:0.65rem">Website</span>
                  <% } else { %>
                    <span style="color:#888;font-size:0.75rem">Direct</span>
                  <% } %>
                </td>
                <td><%= o.customer_name %><% if (o.address) { %><br><small style="color:#888"><%= o.address %></small><% } %></td>
                <td><a href="tel:<%= o.phone %>" style="color:#2d5a27"><%= o.phone %></a></td>
                <td>
                  <ul class="order-items">
                    <% (o.items || []).forEach(item => { %>
                      <li><%= (productsMap[item.productId] || {}).name_en || item.productId %> x<%= item.quantity %> — ₹<%= item.price * item.quantity %></li>
                    <% }) %>
                  </ul>
                </td>
                <td class="product-price">₹<%= o.total %></td>
                <td>
                  <% if (o.commission_amount && o.channel === 'distributor') { %>
                    <span style="color:#856404;font-weight:600">₹<%= o.commission_amount %></span>
                    <br><small style="color:#888"><%= o.commission_rate || 0 %>%</small>
                  <% } else { %>
                    <span style="color:#ccc">—</span>
                  <% } %>
                </td>
                <td><%= new Date(o.order_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                <td><span class="badge badge-<%= o.status %>"><%= o.status %></span></td>
                <td class="actions">
                  <select onchange="updateOrderStatus('<%= o.id %>', this.value)">
                    <option value="pending" <%= o.status==='pending'?'selected':'' %>>Pending</option>
                    <option value="confirmed" <%= o.status==='confirmed'?'selected':'' %>>Confirmed</option>
                    <option value="delivered" <%= o.status==='delivered'?'selected':'' %>>Delivered</option>
                    <option value="cancelled" <%= o.status==='cancelled'?'selected':'' %>>Cancelled</option>
                  </select>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- SUBSCRIPTIONS PANEL -->
    <div id="subscriptions" class="panel">
      <div class="panel-header">
        <h2>Active Subscriptions</h2>
      </div>
      <% if (subscriptions.length === 0) { %>
        <div class="empty">No subscriptions yet. Subscriptions will appear here when customers subscribe.</div>
      <% } else { %>
        <table>
          <thead>
            <tr><th>ID</th><th>Customer</th><th>Phone</th><th>Product</th><th>Qty</th><th>Freq</th><th>Price</th><th>Next Delivery</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% subscriptions.forEach(s => { %>
              <tr>
                <td><strong><%= s.id.slice(0,8) %></strong></td>
                <td><%= s.customer_name %><% if (s.address) { %><br><small style="color:#888"><%= s.address %></small><% } %></td>
                <td><a href="tel:<%= s.phone %>" style="color:#2d5a27"><%= s.phone %></a></td>
                <td><%= (productsMap[s.product_id] || {}).name_en || s.product_id %></td>
                <td><%= s.quantity %> kg</td>
                <td><%= s.frequency %></td>
                <td class="product-price">₹<%= s.price %></td>
                <td>
                  <span class="<%= new Date(s.next_delivery) <= new Date() ? 'badge badge-pending' : '' %>"><%= s.next_delivery %></span>
                </td>
                <td><span class="badge badge-<%= s.status %>"><%= s.status %></span></td>
                <td class="actions" style="flex-wrap:wrap">
                  <button class="btn btn-sm btn-success" onclick="markDelivered('<%= s.id %>', <%= s.quantity %>)">Deliver</button>
                  <button class="btn btn-sm btn-outline" onclick="toggleDeliveries('<%= s.id %>', this)">History</button>
                  <select onchange="updateSubStatus('<%= s.id %>', this.value)" style="font-size:0.75rem">
                    <option value="active" <%= s.status==='active'?'selected':'' %>>Active</option>
                    <option value="paused" <%= s.status==='paused'?'selected':'' %>>Paused</option>
                    <option value="cancelled" <%= s.status==='cancelled'?'selected':'' %>>Cancelled</option>
                  </select>
                </td>
              </tr>
              <tr id="hist-<%= s.id %>" style="display:none">
                <td colspan="10" style="padding:0">
                  <div style="background:#f8f9fa;padding:12px 16px;border-top:1px solid #eee">
                    <strong style="font-size:0.8rem">Delivery History</strong>
                    <div id="hist-content-<%= s.id %>" style="font-size:0.8rem;color:#555;margin-top:4px">Loading...</div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- CUSTOMERS PANEL -->
    <div id="customers" class="panel">
      <div class="panel-header">
        <h2>Customer Directory</h2>
      </div>
      <% if (customers.length === 0) { %>
        <div class="empty">No customers yet. Customers are auto-created when orders or subscriptions are placed.</div>
      <% } else { %>
        <table>
          <thead>
            <tr><th>Name</th><th>Phone</th><th>Address</th><th>Notes</th><th>Joined</th></tr>
          </thead>
          <tbody>
            <% customers.forEach(c => { %>
              <tr>
                <td><strong><%= c.name %></strong></td>
                <td><a href="tel:<%= c.phone %>" style="color:#2d5a27"><%= c.phone %></a></td>
                <td><%= c.address || '—' %></td>
                <td><%= c.notes || '—' %></td>
                <td><%= new Date(c.created_at).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- DISTRIBUTORS PANEL -->
    <div id="distributors" class="panel">
      <div class="panel-header">
        <h2>Distributors</h2>
        <button class="btn btn-primary" onclick="openDistModal()">+ Add Distributor</button>
      </div>
      <% if (distributors.length === 0) { %>
        <div class="empty">No distributors yet. Add your first distributor to start tracking wholesale sales.</div>
      <% } else { %>
        <table>
          <thead>
            <tr><th>Name</th><th>Phone</th><th>Company</th><th>City</th><th>Commission</th><th>Notes</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% distributors.forEach(d => { %>
              <tr>
                <td><strong><%= d.name %></strong></td>
                <td><a href="tel:<%= d.phone %>" style="color:#2d5a27"><%= d.phone || '—' %></a></td>
                <td><%= d.company || '—' %></td>
                <td><%= d.city || '—' %></td>
                <td class="product-price"><%= d.commission_pct %>%</td>
                <td><small><%= d.notes || '—' %></small></td>
                <td><span class="badge badge-<%= d.active !== false ? 'active' : 'cancelled' %>"><%= d.active !== false ? 'Active' : 'Inactive' %></span></td>
                <td class="actions">
                  <button class="btn btn-sm btn-warning" onclick='editDist(<%- JSON.stringify(d) %>)'>Edit</button>
                  <button class="btn btn-sm btn-<%= d.active !== false ? 'outline' : 'success' %>" onclick="toggleDist('<%= d.id %>', <%= d.active === false %>)"><%= d.active === false ? 'Enable' : 'Disable' %></button>
                  <button class="btn btn-sm btn-danger" onclick="deleteDist('<%= d.id %>', '<%= d.name %>')">Delete</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <!-- PRODUCT MODAL -->
  <div id="productModal" class="modal-overlay" onclick="if(event.target===this)closeProductModal()">
    <div class="modal">
      <div class="modal-header">
        <h3 id="modalTitle">Add New Product</h3>
        <button class="modal-close" onclick="closeProductModal()">&times;</button>
      </div>
      <form id="productForm" onsubmit="saveProduct(event)">
        <div class="modal-body">
          <input type="hidden" id="pf_id" value="">

          <div class="form-section">Basic Info</div>
          <div class="form-grid">
            <div class="form-group">
              <label>Product Name (English) *</label>
              <input type="text" id="pf_name_en" required>
            </div>
            <div class="form-group">
              <label>Product Name (Marathi) *</label>
              <input type="text" id="pf_name_mr" required>
            </div>
            <div class="form-group">
              <label>Emoji Icon *</label>
              <input type="text" id="pf_emoji" placeholder="e.g. 💓" maxlength="4" required>
            </div>
            <div class="form-group">
              <label>Category</label>
              <select id="pf_category">
                <option value="millet">Millet</option>
                <option value="dal">Dal</option>
                <option value="specialty">Specialty</option>
              </select>
            </div>
          </div>

          <div class="form-section">Descriptions</div>
          <div class="form-grid">
            <div class="form-group full">
              <label>Description (English)</label>
              <textarea id="pf_desc_en" rows="2"></textarea>
            </div>
            <div class="form-group full">
              <label>Description (Marathi)</label>
              <textarea id="pf_desc_mr" rows="2"></textarea>
            </div>
          </div>

          <div class="form-section">Pricing & Weight</div>
          <div class="form-grid">
            <div class="form-group">
              <label>Price per kg (₹) *</label>
              <input type="number" id="pf_price" min="1" required>
            </div>
            <div class="form-group">
              <label>Weight (kg)</label>
              <input type="number" id="pf_weight" min="0.1" step="0.1" value="1">
            </div>
          </div>

          <div class="form-section">Badges & Tags</div>
          <div class="form-grid">
            <div class="form-group">
              <label>Badge (English)</label>
              <input type="text" id="pf_badge_en" placeholder="e.g. High Protein">
            </div>
            <div class="form-group">
              <label>Badge (Marathi)</label>
              <input type="text" id="pf_badge_mr" placeholder="e.g. उच्च प्रथिने">
            </div>
            <div class="form-group">
              <label>Tags (English, comma-separated)</label>
              <input type="text" id="pf_tags" placeholder="e.g. Low GI, High Fiber">
            </div>
            <div class="form-group">
              <label>Tags (Marathi, comma-separated)</label>
              <input type="text" id="pf_tags_mr" placeholder="e.g. कमी GI, उच्च फायबर">
            </div>
          </div>

          <div class="form-section">Photo</div>
          <div class="form-group">
            <label>Product Photo (Google Drive link or direct image URL)</label>
            <div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">
              <div style="flex:1;min-width:200px">
                <input type="text" id="pf_image" placeholder="Paste Google Drive link or image URL" style="width:100%">
                <small style="color:#888;font-size:0.75rem">Google Drive links auto-convert. Direct URLs (Imgur, etc.) also work.</small>
              </div>
              <div id="pf_imagePreview" style="width:80px;height:80px;border-radius:8px;overflow:hidden;background:#f0f0f0;display:none;flex-shrink:0">
                <img id="pf_previewImg" src="" style="width:100%;height:100%;object-fit:cover">
              </div>
            </div>
          </div>

          <div class="form-section">Ingredients</div>
          <div class="form-grid">
            <div class="form-group full">
              <label>Ingredients (English)</label>
              <textarea id="pf_ing_en" rows="2" placeholder="e.g. Whole wheat flour, barley flour, fenugreek powder..."></textarea>
            </div>
            <div class="form-group full">
              <label>Ingredients (Marathi)</label>
              <textarea id="pf_ing_mr" rows="2" placeholder="e.g. कडधान्य पीठ, बार्ली पीठ, मेथी पूड..."></textarea>
            </div>
          </div>

          <div class="form-section">Nutrition (per 100g)</div>
          <div class="form-grid">
            <div class="form-group">
              <label>Calories</label>
              <input type="number" id="pf_cal" min="0" value="0">
            </div>
            <div class="form-group">
              <label>Protein (g)</label>
              <input type="number" id="pf_prot" min="0" step="0.1" value="0">
            </div>
            <div class="form-group">
              <label>Fiber (g)</label>
              <input type="number" id="pf_fiber" min="0" step="0.1" value="0">
            </div>
            <div class="form-group">
              <label>Carbs (g)</label>
              <input type="number" id="pf_carbs" min="0" step="0.1" value="0">
            </div>
            <div class="form-group">
              <label>Fat (g)</label>
              <input type="number" id="pf_fat" min="0" step="0.1" value="0">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" onclick="closeProductModal()">Cancel</button>
          <button type="submit" class="btn btn-primary" id="pf_submit">Add Product</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // EMBED DATA FOR CLIENT-SIDE FILTERING
    const ALL_ORDERS = <%- JSON.stringify(orders) %>;
    const ALL_DELIVERIES = <%- JSON.stringify(deliveries) %>;
    const PRODUCTS_MAP = <%- JSON.stringify(productsMap) %>;
    const ALL_SUBSCRIPTIONS = <%- JSON.stringify(subscriptions) %>;
    const ALL_DISTRIBUTORS = <%- JSON.stringify(distributors) %>;
    const DISTRIBUTORS_MAP = {};
    ALL_DISTRIBUTORS.forEach(d => { DISTRIBUTORS_MAP[d.id] = d; });

    let currentFilter = 'ltd';
    let currentStatusFilter = 'all';
    let currentChannelFilter = 'all';

    function getDateRange(filter) {
      const now = new Date();
      const start = new Date();
      switch (filter) {
        case 'wtd':
          const day = now.getDay();
          start.setDate(now.getDate() - (day === 0 ? 6 : day - 1));
          start.setHours(0, 0, 0, 0);
          break;
        case 'mtd':
          start.setDate(1);
          start.setHours(0, 0, 0, 0);
          break;
        case 'ytd':
          start.setMonth(0, 1);
          start.setHours(0, 0, 0, 0);
          break;
        case 'ltd':
        default:
          return null;
      }
      return start;
    }

    function filterOrders(filter) {
      const range = getDateRange(filter);
      let orders = range ? ALL_ORDERS.filter(o => new Date(o.order_date) >= range) : ALL_ORDERS;
      orders = orders.filter(o => o.status !== 'cancelled');
      if (currentStatusFilter !== 'all') {
        orders = orders.filter(o => o.status === currentStatusFilter);
      }
      if (currentChannelFilter !== 'all') {
        orders = orders.filter(o => (o.channel || 'direct') === currentChannelFilter);
      }
      return orders;
    }

    function filterAllOrders(filter) {
      const range = getDateRange(filter);
      let orders = range ? ALL_ORDERS.filter(o => new Date(o.order_date) >= range) : ALL_ORDERS;
      if (currentStatusFilter !== 'all') {
        orders = orders.filter(o => o.status === currentStatusFilter);
      }
      if (currentChannelFilter !== 'all') {
        orders = orders.filter(o => (o.channel || 'direct') === currentChannelFilter);
      }
      return orders;
    }

    function updateStats(filter) {
      const activeOrders = filterOrders(filter);
      const allFiltered = filterAllOrders(filter);
      const range = getDateRange(filter);

      const subDeliveries = range
        ? ALL_DELIVERIES.filter(d => new Date(d.delivered_date) >= range)
        : ALL_DELIVERIES;

      const orderRevenue = activeOrders.reduce((sum, o) => sum + (o.total || 0), 0);
      const subRevenue = subDeliveries.reduce((sum, d) => sum + ((d.aap_subscriptions && d.aap_subscriptions.price) || 0), 0);

      document.getElementById('stat-total-orders').textContent = activeOrders.length;
      document.getElementById('stat-pending-orders').textContent = currentStatusFilter === 'all'
        ? activeOrders.filter(o => o.status === 'pending').length
        : (currentStatusFilter === 'pending' ? activeOrders.length : 0);
      document.getElementById('stat-revenue').textContent = '₹' + (orderRevenue + subRevenue).toLocaleString('en-IN');
      document.getElementById('stat-sub-deliveries').textContent = subDeliveries.length;

      // Distributor stats
      const distOrders = activeOrders.filter(o => o.channel === 'distributor');
      const commissionOwed = distOrders.reduce((sum, o) => sum + (o.commission_amount || 0), 0);
      document.getElementById('stat-dist-orders').textContent = distOrders.length;
      document.getElementById('stat-commission-owed').textContent = '₹' + commissionOwed.toLocaleString('en-IN');
    }

    function renderOrdersTable(filter) {
      const allFiltered = filterAllOrders(filter);
      const tbody = document.getElementById('orders-tbody');
      const emptyMsg = document.getElementById('orders-empty');

      if (allFiltered.length === 0) {
        tbody.innerHTML = '';
        emptyMsg.style.display = 'block';
        return;
      }

      emptyMsg.style.display = 'none';
      tbody.innerHTML = allFiltered.slice().reverse().map(o => {
        const items = (o.items || []).map(item => {
          const prod = PRODUCTS_MAP[item.productId] || {};
          return '<li>' + (prod.name_en || item.productId) + ' x' + item.quantity + ' — ₹' + (item.price * item.quantity) + '</li>';
        }).join('');
        const dateStr = new Date(o.order_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
        const addr = o.address ? '<br><small style="color:#888">' + o.address + '</small>' : '';

        let channelCell = '';
        if (o.channel === 'distributor' && o.distributor_id) {
          const dist = DISTRIBUTORS_MAP[o.distributor_id] || {};
          channelCell = '<span class="badge badge-confirmed" style="font-size:0.65rem">' + (dist.name || o.distributor_id) + '</span>';
          if (o.delivery_area) channelCell += '<br><small style="color:#888">' + o.delivery_area + '</small>';
        } else if (o.channel === 'website') {
          channelCell = '<span class="badge badge-pending" style="font-size:0.65rem">Website</span>';
        } else {
          channelCell = '<span style="color:#888;font-size:0.75rem">Direct</span>';
        }

        let commCell = '<span style="color:#ccc">—</span>';
        if (o.commission_amount && o.channel === 'distributor') {
          commCell = '<span style="color:#856404;font-weight:600">₹' + o.commission_amount + '</span><br><small style="color:#888">' + (o.commission_rate || 0) + '%</small>';
        }

        return '<tr>' +
          '<td><strong>' + o.id.slice(0,8) + '</strong></td>' +
          '<td>' + channelCell + '</td>' +
          '<td>' + o.customer_name + addr + '</td>' +
          '<td><a href="tel:' + o.phone + '" style="color:#2d5a27">' + o.phone + '</a></td>' +
          '<td><ul class="order-items">' + items + '</ul></td>' +
          '<td class="product-price">₹' + o.total + '</td>' +
          '<td>' + commCell + '</td>' +
          '<td>' + dateStr + '</td>' +
          '<td><span class="badge badge-' + o.status + '">' + o.status + '</span></td>' +
          '<td class="actions"><select onchange="updateOrderStatus(\'' + o.id + '\', this.value)">' +
            '<option value="pending"' + (o.status==='pending'?' selected':'') + '>Pending</option>' +
            '<option value="confirmed"' + (o.status==='confirmed'?' selected':'') + '>Confirmed</option>' +
            '<option value="delivered"' + (o.status==='delivered'?' selected':'') + '>Delivered</option>' +
            '<option value="cancelled"' + (o.status==='cancelled'?' selected':'') + '>Cancelled</option>' +
          '</select></td>' +
        '</tr>';
      }).join('');
    }

    function applyFilter(filter, btn) {
      currentFilter = filter;
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      updateStats(filter);
      renderOrdersTable(filter);
    }

    function applyStatusFilter(status, btn) {
      currentStatusFilter = status;
      // Only toggle active state for status filter buttons (after the separator)
      const allBtns = document.querySelectorAll('.filter-btn');
      const separator = document.querySelector('.filter-bar span');
      let inStatusSection = false;
      allBtns.forEach(b => {
        if (separator && b.previousElementSibling === separator) inStatusSection = true;
        if (inStatusSection) b.classList.remove('active');
      });
      if (btn) btn.classList.add('active');
      updateStats(currentFilter);
      renderOrdersTable(currentFilter);
    }

    function applyChannelFilter(channel, btn) {
      currentChannelFilter = channel;
      const allBtns = document.querySelectorAll('.filter-btn');
      let inChannelSection = false;
      let count = 0;
      allBtns.forEach(b => {
        if (b.textContent.trim() === 'All Channels') inChannelSection = true;
        if (inChannelSection) { b.classList.remove('active'); count++; }
        if (count > 5) inChannelSection = false;
      });
      if (btn) btn.classList.add('active');
      updateStats(currentFilter);
      renderOrdersTable(currentFilter);
    }

    function exportCSV() {
      const orders = filterAllOrders(currentFilter);
      if (orders.length === 0) return showToast('No orders to export', 'error');

      const headers = ['Order ID', 'Channel', 'Distributor', 'Customer', 'Phone', 'Address', 'Items', 'Total', 'Commission Rate', 'Commission Amt', 'Date', 'Status'];
      const rows = orders.map(o => {
        const items = (o.items || []).map(item => {
          const prod = PRODUCTS_MAP[item.productId] || {};
          return (prod.name_en || item.productId) + ' x' + item.quantity;
        }).join('; ');
        const dateStr = new Date(o.order_date).toLocaleDateString('en-IN');
        const dist = o.distributor_id ? (DISTRIBUTORS_MAP[o.distributor_id] || {}) : {};
        return [
          o.id,
          o.channel || 'direct',
          '"' + (dist.name || '').replace(/"/g, '""') + '"',
          '"' + (o.customer_name || '').replace(/"/g, '""') + '"',
          o.phone || '',
          '"' + (o.address || '').replace(/"/g, '""') + '"',
          '"' + items.replace(/"/g, '""') + '"',
          o.total || 0,
          (o.commission_rate || 0) + '%',
          o.commission_amount || 0,
          dateStr,
          o.status
        ].join(',');
      });

      const csv = [headers.join(','), ...rows].join('\n');
      const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'annapurna_orders_' + currentFilter + '_' + new Date().toISOString().split('T')[0] + '.csv';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Exported ' + orders.length + ' orders');
    }

    // TAB NAVIGATION
    function showTab(name, el) {
      document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.getElementById(name).classList.add('active');
      if (el) el.classList.add('active');
    }

    // TOAST
    function showToast(msg, type) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = 'toast toast-' + (type || 'success') + ' show';
      setTimeout(() => t.classList.remove('show'), 3000);
    }

    // Google Drive URL auto-converter
    function convertImageUrl(url) {
      if (!url) return '';
      url = url.trim();
      var m = url.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/);
      if (m) return 'https://lh3.googleusercontent.com/d/' + m[1];
      m = url.match(/drive\.google\.com\/open\?id=([a-zA-Z0-9_-]+)/);
      if (m) return 'https://lh3.googleusercontent.com/d/' + m[1];
      m = url.match(/drive\.google\.com\/uc\?export=view&(?:amp;)?id=([a-zA-Z0-9_-]+)/);
      if (m) return 'https://lh3.googleusercontent.com/d/' + m[1];
      return url;
    }

    // Live preview on paste
    document.getElementById('pf_image').addEventListener('input', function() {
      var url = convertImageUrl(this.value);
      var preview = document.getElementById('pf_imagePreview');
      var img = document.getElementById('pf_previewImg');
      if (url) {
        img.src = url;
        preview.style.display = 'block';
        img.onerror = function() { preview.style.display = 'none'; };
      } else {
        preview.style.display = 'none';
      }
    });

    // PRODUCT MODAL
    function openProductModal(product) {
      const m = document.getElementById('productModal');
      const title = document.getElementById('modalTitle');
      const submit = document.getElementById('pf_submit');

      if (product) {
        title.textContent = 'Edit Product';
        submit.textContent = 'Save Changes';
        document.getElementById('pf_id').value = product.id;
        document.getElementById('pf_name_en').value = product.name_en || '';
        document.getElementById('pf_name_mr').value = product.name_mr || '';
        document.getElementById('pf_emoji').value = product.emoji || '';
        document.getElementById('pf_category').value = product.category || 'millet';
        document.getElementById('pf_desc_en').value = product.description_en || '';
        document.getElementById('pf_desc_mr').value = product.description_mr || '';
        document.getElementById('pf_price').value = product.price || '';
        document.getElementById('pf_weight').value = product.weight_kg || 1;
        document.getElementById('pf_badge_en').value = product.badge_en || '';
        document.getElementById('pf_badge_mr').value = product.badge_mr || '';
        document.getElementById('pf_tags').value = (product.tags || []).join(', ');
        document.getElementById('pf_tags_mr').value = (product.tags_mr || []).join(', ');
        document.getElementById('pf_image').value = product.image || '';
        // Show preview if image exists
        if (product.image) {
          var preview = document.getElementById('pf_imagePreview');
          var img = document.getElementById('pf_previewImg');
          img.src = product.image;
          preview.style.display = 'block';
          img.onerror = function() { preview.style.display = 'none'; };
        } else {
          document.getElementById('pf_imagePreview').style.display = 'none';
        }
        document.getElementById('pf_ing_en').value = product.ingredients_en || '';
        document.getElementById('pf_ing_mr').value = product.ingredients_mr || '';
        const n = product.nutrition || {};
        document.getElementById('pf_cal').value = n.calories || 0;
        document.getElementById('pf_prot').value = n.protein || 0;
        document.getElementById('pf_fiber').value = n.fiber || 0;
        document.getElementById('pf_carbs').value = n.carbs || 0;
        document.getElementById('pf_fat').value = n.fat || 0;
      } else {
        title.textContent = 'Add New Product';
        submit.textContent = 'Add Product';
        document.getElementById('productForm').reset();
        document.getElementById('pf_id').value = '';
        document.getElementById('pf_weight').value = '1';
      }
      m.classList.add('show');
    }

    function closeProductModal() {
      document.getElementById('productModal').classList.remove('show');
    }

    function editProduct(product) {
      openProductModal(product);
    }

    async function saveProduct(e) {
      e.preventDefault();
      const id = document.getElementById('pf_id').value;
      const data = {
        name_en: document.getElementById('pf_name_en').value,
        name_mr: document.getElementById('pf_name_mr').value,
        emoji: document.getElementById('pf_emoji').value,
        category: document.getElementById('pf_category').value,
        description_en: document.getElementById('pf_desc_en').value,
        description_mr: document.getElementById('pf_desc_mr').value,
        price: parseInt(document.getElementById('pf_price').value),
        weight_kg: parseFloat(document.getElementById('pf_weight').value),
        badge_en: document.getElementById('pf_badge_en').value,
        badge_mr: document.getElementById('pf_badge_mr').value,
        tags: document.getElementById('pf_tags').value.split(',').map(s => s.trim()).filter(Boolean),
        tags_mr: document.getElementById('pf_tags_mr').value.split(',').map(s => s.trim()).filter(Boolean),
        image: convertImageUrl(document.getElementById('pf_image').value),
        ingredients_en: document.getElementById('pf_ing_en').value,
        ingredients_mr: document.getElementById('pf_ing_mr').value,
        nutrition: {
          calories: parseInt(document.getElementById('pf_cal').value) || 0,
          protein: parseFloat(document.getElementById('pf_prot').value) || 0,
          fiber: parseFloat(document.getElementById('pf_fiber').value) || 0,
          carbs: parseFloat(document.getElementById('pf_carbs').value) || 0,
          fat: parseFloat(document.getElementById('pf_fat').value) || 0
        },
        active: true
      };

      try {
        const url = id ? '/api/products/' + id : '/api/products';
        const method = id ? 'PUT' : 'POST';
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) {
          showToast(id ? 'Product updated!' : 'Product added!');
          setTimeout(() => location.reload(), 800);
        } else {
          const err = await res.json();
          showToast(err.error || 'Error saving product', 'error');
        }
      } catch (err) {
        showToast('Network error', 'error');
      }
    }

